generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  OPEN
  WAITING
  ACTIVE
  PAUSED
  WAITING_EXTERNAL
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum SubtaskStatus {
  OPEN
  WAITING
  ACTIVE
  PAUSED
  WAITING_EXTERNAL
  COMPLETED
  ARCHIVED
  CANCELLED
}

enum TimeSessionType {
  ACTIVE
  PAUSED
  INTERRUPTED
  WAITING_EXTERNAL
}

enum InterruptionReason {
  CONTEXT_SWITCH
  MEETING
  BREAK
  DISTRACTION
  TECHNICAL_ISSUE
  OTHER
}

enum TaskSourceType {
  MANUAL
  IMPORTED
}

enum DependencyType {
  FINISH_TO_START
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  timeZone            String               @default("Europe/Amsterdam")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  tasks               Task[]
  taskAttachments     TaskAttachment[]
  timeSessions        TimeSession[]
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  microsoftToken      MicrosoftToken?
  todoImportBatches   TodoImportBatch[]

  @@map("users")
}

model Task {
  id                  String         @id @default(cuid())
  userId              String
  title               String
  descriptionOriginal String         @default("")
  descriptionPlain    String         @default("")
  status              TaskStatus     @default(OPEN)
  deadline            DateTime?
  estimatedMinutes    Int?
  remainingMinutes    Int?
  sourceType          TaskSourceType @default(MANUAL)
  sourceExternalId    String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  completedAt         DateTime?
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks            Subtask[]
  attachments         TaskAttachment[]
  todoImportItems     TodoImportItem[]
  timeSessions        TimeSession[]

  @@index([userId, status])
  @@index([userId, deadline])
  @@unique([userId, sourceExternalId])
  @@index([updatedAt])
  @@map("tasks")
}

model Subtask {
  id                       String            @id @default(cuid())
  taskId                   String
  title                    String
  descriptionOriginal      String            @default("")
  descriptionPlain         String            @default("")
  deadline                 DateTime?
  earliestStart            DateTime?
  estimatedMinutes         Int
  remainingMinutes         Int
  minimumBlockMinutes      Int               @default(15)
  splittable               Boolean           @default(false)
  priority                 Int?
  context                  String?
  status                   SubtaskStatus     @default(OPEN)
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  completedAt              DateTime?
  task                     Task              @relation(fields: [taskId], references: [id], onDelete: Cascade)
  timeSessions             TimeSession[]
  dependenciesAsBlockedBy  TaskDependency[]   @relation("task_dependency_blocked")
  dependenciesAsPrerequisite TaskDependency[] @relation("task_dependency_prerequisite")
  attachments               TaskAttachment[]

  @@index([taskId, status])
  @@index([deadline])
  @@index([status, deadline])
  @@map("subtasks")
}

model TimeSession {
  id                 String             @id @default(cuid())
  userId             String
  taskId             String?
  subtaskId          String?
  sessionType        TimeSessionType
  startedAt          DateTime
  endedAt            DateTime?
  activeSeconds      Int                @default(0)
  note               String?
  interruptionReason InterruptionReason?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  task               Task?              @relation(fields: [taskId], references: [id], onDelete: Restrict)
  subtask            Subtask?           @relation(fields: [subtaskId], references: [id], onDelete: Restrict)

  @@index([userId, startedAt])
  @@index([taskId, startedAt])
  @@index([subtaskId, startedAt])
  @@map("time_sessions")
}

model TaskDependency {
  id                  String        @id @default(cuid())
  subtaskId           String
  dependsOnSubtaskId  String
  dependencyType      DependencyType @default(FINISH_TO_START)
  createdAt           DateTime      @default(now())
  subtask             Subtask       @relation("task_dependency_blocked", fields: [subtaskId], references: [id], onDelete: Restrict)
  dependsOnSubtask    Subtask       @relation("task_dependency_prerequisite", fields: [dependsOnSubtaskId], references: [id], onDelete: Restrict)

  @@unique([subtaskId, dependsOnSubtaskId])
  @@index([dependsOnSubtaskId])
  @@map("task_dependencies")
}

model TaskAttachment {
  id                String   @id @default(cuid())
  userId            String
  taskId            String?
  subtaskId         String?
  blobPath          String?
  sourceUrl         String?
  originalFileName   String?
  mimeType          String?
  sizeBytes         Int?
  sourceExternalId   String?
  source            String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task              Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  subtask           Subtask? @relation(fields: [subtaskId], references: [id], onDelete: Cascade)

  @@index([userId, taskId])
  @@index([userId, subtaskId])
  @@unique([userId, sourceExternalId])
  @@index([taskId])
  @@index([subtaskId])
  @@map("task_attachments")
}

model TodoImportBatch {
  id              String           @id @default(cuid())
  userId          String
  microsoftConnectionId String
  sourceLists     Json
  status          String
  startedAt       DateTime
  completedAt     DateTime?
  sourceCount     Int              @default(0)
  importedCount   Int              @default(0)
  skippedCount    Int              @default(0)
  errorCount      Int              @default(0)
  createdAt       DateTime         @default(now())
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           TodoImportItem[]

  @@index([userId, startedAt])
  @@index([microsoftConnectionId])
  @@map("todo_import_batches")
}

model TodoImportItem {
  id                  String            @id @default(cuid())
  importBatchId       String
  externalListId      String
  externalTaskId      String
  targetTaskId        String?
  sourceHash          String
  importedAttachmentCount Int            @default(0)
  status              String
  errorMessage        String?
  createdAt           DateTime          @default(now())
  importBatch         TodoImportBatch   @relation(fields: [importBatchId], references: [id], onDelete: Cascade)
  targetTask          Task?             @relation(fields: [targetTaskId], references: [id], onDelete: SetNull)

  @@unique([externalListId, externalTaskId])
  @@index([importBatchId])
  @@index([targetTaskId])
  @@index([sourceHash])
  @@map("todo_import_items")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}

model AuthThrottle {
  id              String    @id @default(cuid())
  keyHash         String    @unique
  failureCount    Int       @default(0)
  windowStartedAt DateTime
  blockedUntil    DateTime?
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([blockedUntil])
  @@index([expiresAt])
  @@map("auth_throttles")
}

model MicrosoftToken {
  id                   String   @id @default(cuid())
  userId               String   @unique
  encryptedAccessToken String
  encryptedRefreshToken String
  accessTokenExpiresAt DateTime
  scope                String
  microsoftAccountId   String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("microsoft_tokens")
}
